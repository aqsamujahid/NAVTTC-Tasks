    "# python program to fid the area of a triangle\n",
    "a=2\n",
    "b=3\n",
    "c=4\n",
    "s = (a+b+c)/2\n",
    "area = (s*(s-a)*(s-b)*(s-c))**0.5\n",
    "print('the area of the triangle is %0.2f' %area)"
