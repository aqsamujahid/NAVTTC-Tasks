   "source": [
    "# solving quadratic equation\n",
    "import cmath\n",
    "a=1\n",
    "b=2\n",
    "c=3\n",
    "d = (b**2)-(4*a*c)\n",
    "sol1 = (-b-cmath.sqrt(d))/(2*a)\n",
    "sol2 = (-b+cmath.sqrt(d))/(2*a)\n",
    "print('the solutions are {0} and {1}'. format(sol1, sol2))"
   ]
